{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coffee CLI",
  "version": "0.1.0",
  "identifier": "com.coffeecli.mobile",
  "build": {
    "frontendDist": "../src-ui/dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../src-ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Coffee CLI",
        "url": "index.html?remote&control"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["../icons/32x32.png", "../icons/128x128.png", "../icons/128x128@2x.png", "../icons/icon.icns", "../icons/icon.ico"]
  }
}

# Cloudflare Pages response headers.
#
# css/ and js/ are always linked with a ?v= that is bumped on every change,
# and fonts/ never change, so they can be cached for a year. Clips and
# icons keep their names across releases: a week. HTML and version.json are
# revalidated on every load so a deploy shows up at once.

/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/demo/*
  Cache-Control: public, max-age=604800
/agents/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800

/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/courses/*
  Cache-Control: public, max-age=0, must-revalidate
/version.json
  Cache-Control: public, max-age=0, must-revalidate
/prices.json
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
